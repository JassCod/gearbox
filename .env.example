# Copy to .env.local for local development. Leave empty to run in local (single-browser) mode.
# Both values are on Supabase → Project Settings → API. The anon key is safe to expose in the browser;
# the database's row-level security rules decide what each signed-in user may do.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
